{
  "manifest_version": 3,
  "name": "UniMem browser capture",
  "version": "0.2.0",
  "description": "Save selected text or the current page to your local UniMem capture API.",
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save selected text to UniMem"
  }
}
