{
  "manifest_version": 3,
  "minimum_chrome_version": "121",
  "name": "UniMem browser capture",
  "version": "0.5.0",
  "description": "Сохранение текста, страниц и субтитров YouTube в локальный UniMem.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "service-worker.js"
    ],
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Сохранить выделенный текст в UniMem"
  },
  "options_ui": {
    "page": "manage.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "unimem@zinverno.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "browsingActivity",
          "authenticationInfo"
        ]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8765"
  }
}
