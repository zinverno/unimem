{
  "name": "unimem-browser-extension",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Local UniMem capture for Zen, Firefox and Chromium",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "NO_UPDATE_NOTIFIER=1 web-ext lint --source-dir . --ignore-files \"tests/**\" \"scripts/**\" \"node_modules/**\" \"dist/**\" \"package*.json\" \"README.md\"",
    "build": "node scripts/build.mjs",
    "check-package": "python3 scripts/check-package.py"
  },
  "devDependencies": {
    "web-ext": "10.7.0"
  }
}
